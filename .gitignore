# Vagrant dir
.vagrant

*~
*.doctree
*.swp
*.swo
*.pyc
*.suo
*.user
*.sql3

# Ansible roles
deployment/ansible/roles/azavea.*

# Ansible retry files
deployment/ansible/*.retry

# Wizard output
deployment/ansible/group_vars/production
deployment/ansible/inventory/production

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]

# C extensions
*.so

# Distribution / packaging
.Python
env/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
*.egg-info/
.installed.cfg
*.egg

#OSXIgnore
**/.DS_Store

# PyInstaller
